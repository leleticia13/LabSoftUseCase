<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - appPetShop</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/appPetShop.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-top">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-area="" asp-controller="Account" asp-action="Logout">Sair</a>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Entrar</a>
            }
        </div>

        <div class="header-brand">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">appPetShop</a>
            <span class="brand-sub">Cuidado e elegância para o seu pet</span>
        </div>

        <button class="menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
            Menu
        </button>

        <nav id="menu" class="site-nav collapse">
            <a asp-area="" asp-controller="Home" asp-action="Index">Início</a>
            <a asp-area="" asp-controller="Cliente" asp-action="Index">Clientes</a>
            <a asp-area="" asp-controller="ReservaServico" asp-action="Index">Reservas</a>
            <a asp-area="" asp-controller="Veterinario" asp-action="Index">Veterinários</a>
        </nav>
    </header>

    <main class="page" role="main">
        <div class="page-panel">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span class="footer-brand">appPetShop</span>
            <span class="footer-copy">&copy; 2026 · Todos os direitos reservados</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>