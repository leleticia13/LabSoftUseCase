@model appPetShop.Models.Veterinario

@{
    ViewData["Title"] = "Novo veterinário";
}

<h1>Novo veterinário</h1>
<h4>Cadastro de veterinário</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Crmv" class="control-label">CRMV</label>
                <input asp-for="Crmv" class="form-control" />
                <span asp-validation-for="Crmv" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Especialidade" class="control-label">Especialidade</label>
                <input asp-for="Especialidade" class="form-control" />
                <span asp-validation-for="Especialidade" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Salvar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Voltar para a lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}