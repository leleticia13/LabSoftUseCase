@using System.Globalization
@model IEnumerable<AppTask.Models.CentralCusto>

@{
    ViewData["Title"] = "Central de custos";

    var centrais = Model?.ToList() ?? new List<AppTask.Models.CentralCusto>();

    var moeda = CultureInfo.GetCultureInfo("pt-BR");
}

<div class="page-header">
    <div>
        <h1>Central de custos</h1>

        <p class="text-muted">
            Centrais de custo cadastradas no sistema.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-success text-white">
        <i class="bi bi-plus-lg"></i>
        Nova central de custo
    </a>
</div>

<div class="card-panel">

    @if (!centrais.Any())
    {
        <div class="p-4 text-center">
            <i class="bi bi-database fs-2 text-muted"></i>

            <p class="mt-2 mb-0 text-muted">
                Nenhuma central de custo cadastrada.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nome da central</th>
                        <th>Valor anual da meta</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in centrais)
                    {
                        <tr>

                            <td>
                                @item.CentralId
                            </td>

                            <td>
                                @item.NomeCusto
                            </td>

                            <td>
                                @item.ValorAnualMeta.ToString("C", moeda)
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.CentralId"
                                   class="btn btn-primary btn-sm">
                                    Alterar
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.CentralId"
                                   class="btn btn-success btn-sm text-white">
                                    Detalhes
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.CentralId"
                                   class="btn btn-danger btn-sm">
                                    Excluir
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
}
</div>