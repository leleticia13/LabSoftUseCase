@model AppTask.Models.CentralCusto

@{
    ViewData["Title"] = "Nova central de custo";
}

<h1 class="mb-4">
    Nova central de custo
</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/CentralCusto/Create"
              method="post">

            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
            true,
                        "",
                        new { @class = "text-danger" })

            <div class="mb-3">
                <label asp-for="NomeCusto"
                       class="form-label">
                </label>

                <input asp-for="NomeCusto"
                       class="form-control"
                       maxlength="250"
                       required />

                <span asp-validation-for="NomeCusto"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorAnualMeta"
                       class="form-label">
                </label>

                <input asp-for="ValorAnualMeta"
                       type="number"
                       class="form-control"
                       min="0"
                       step="0.01"
                       placeholder="Ex.: 150000.00"
                       required />

                <span asp-validation-for="ValorAnualMeta"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Salvar
            </button>

            <a href="/CentralCusto"
               class="btn btn-secondary">
                Voltar
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
